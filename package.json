{
  "name": "astro-static-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro check && eslint . && stylelint \"**/*.{css,astro}\"",
    "check:links": "linkinator dist && node scripts/check-urls.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check": "npm run format:check && npm run lint && npm run build && npm run check:links && npm run check:overflow",
    "brand:images": "node scripts/brand-images.mjs"
  },
  "dependencies": {
    "astro": "^7.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "linkinator": "^8.1.0",
    "playwright": "^1.64.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
