---
// The header of every page: the logo, which leads to the home page, and the main navigation, whose
// links are listed in src/i18n/fr.json. The link of the current page is marked with aria-current.
import logo from "../assets/brand/logo.svg?raw";
import fr from "../i18n/fr.json";
import { currentOf, href } from "../lib/url";

const links = [{ path: "/", label: fr.nav.home }];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href={href("/")} aria-label={fr.site.name}>
      <Fragment set:html={logo} />
    </a>
    <nav aria-label={fr.nav.label}>
      <ul>
        {links.map(({ path, label }) => (
          <li>
            <a href={href(path)} aria-current={currentOf(path, current)}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .logo {
    color: var(--color-text);
  }

  .logo :global(svg) {
    width: auto;
    height: 32px;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
  }

  nav a[aria-current] {
    text-decoration: underline;
  }
</style>
